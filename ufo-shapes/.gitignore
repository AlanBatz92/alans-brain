# Raw ingested book/document text must NEVER be committed to the public repo.
# Only the DERIVED, cited data (short fair-use snippets + counts) under
# data/ufo-shapes/ gets committed. See PLAN-ufo-shapes.md "Copyright posture".

# Everything under sources/ stays local — raw book/document text of ANY extension
# (.md/.epub/.pdf/.txt/…) plus the per-source segment folders. Only .gitkeep is tracked.
sources/*
!sources/.gitkeep

# Any loose book files dropped into the toolkit root for processing.
# (.md is NOT globally ignored — the tracked toolkit docs are .md; raw .md books
#  belong under sources/, which is fully ignored above.)
*.epub
*.pdf
*.txt
*.mobi
*.azw3

# Local working layer: the FULL mention set (high + review) before the publish gate.
# Only the gated, high-confidence subset under data/ufo-shapes/ is committed.
work/

# Optional local Python venv for the EPUB/PDF libraries (Phase 1).
.venv/
__pycache__/
*.pyc
