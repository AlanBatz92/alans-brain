[Unit]
Description=Bird Observatory FastAPI
After=network-online.target
Wants=network-online.target

[Service]
User=alan
WorkingDirectory=/home/alan/alans-brain/birdstation
ExecStart=/home/alan/api-env/bin/uvicorn bird_api:app --host 0.0.0.0 --port 8080
Restart=always
RestartSec=10
EnvironmentFile=/etc/birdstation.env

[Install]
WantedBy=multi-user.target
